<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSMicrophoneUsageDescription</key>
    <string>BellAI uses the microphone to capture your spoken messages.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>BellAI transcribes your speech into text to send to your AI server.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>OLLAMA_MODEL</key>
	<string>$(OLLAMA_MODEL)</string>
	<key>VOICE_SERVER_HOST</key>
	<string>$(VOICE_SERVER_HOST)</string>
</dict>
</plist>
